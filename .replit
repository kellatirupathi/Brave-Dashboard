modules = ["nodejs-24", "python-3.11", "java-graalvm22.3", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["jdk17"]

[userenv]

[userenv.shared]
VITE_FORMS_LOGIN_URL = "https://forms.ccbp.in/mid/brave-dashboard"
BOOTSTRAP_ADMIN_FORMS_IDS = "853cac17-6251-4d40-8ccf-1ec1bce6e949"
NIXPKGS_ACCEPT_ANDROID_SDK_LICENSE = "1"
BRAVE_ANDROID_KEYSTORE_PATH = "brave-release.jks"
BRAVE_ANDROID_KEY_ALIAS = "brave-release"

[userenv.production]

[objectStorage]
defaultBucketID = "replit-objstore-2853e21d-0c7f-4ce6-98b7-e041e3c16b30"
