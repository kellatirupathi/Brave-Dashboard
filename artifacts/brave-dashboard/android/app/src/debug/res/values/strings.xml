<?xml version='1.0' encoding='utf-8'?>
<!--
  Debug-variant overrides.

  The debug build carries its own applicationId (see applicationIdSuffix in
  build.gradle), so it needs its own name and URL scheme too: two launcher
  icons both labelled "BRAVE" is a support ticket waiting to happen, and two
  apps claiming in.niatindia.brave:// would make Android show a chooser.
-->
<resources>
    <string name="app_name">BRAVE Test</string>
    <string name="title_activity_main">BRAVE Test</string>
    <string name="custom_url_scheme">in.niatindia.brave.test</string>
</resources>
